{
  "name": "chrome-media-control-chrome",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build:extension && npm run build:backend",
    "build:extension": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "dev": "vite build --watch",
    "start:backend": "node backend-dist/backend/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
